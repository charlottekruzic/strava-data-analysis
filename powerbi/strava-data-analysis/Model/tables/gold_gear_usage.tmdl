table gold_gear_usage

	measure 'Gear Distance' = ROUND(SUM(gold_gear_usage[total_distance_km]),0)

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column gear_id
		dataType: string
		sourceProviderType: nvarchar(50)
		summarizeBy: none
		sourceColumn: gear_id

		annotation SummarizationSetBy = Automatic

	column athlete_id
		dataType: int64
		formatString: 0
		sourceProviderType: bigint
		summarizeBy: none
		sourceColumn: athlete_id

		annotation SummarizationSetBy = Automatic

	column gear_name
		dataType: string
		sourceProviderType: nvarchar(100)
		summarizeBy: none
		sourceColumn: gear_name

		annotation SummarizationSetBy = Automatic

	column total_distance_km
		dataType: double
		sourceProviderType: double
		summarizeBy: none
		sourceColumn: total_distance_km

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition gold_gear_usage = m
		mode: directQuery
		source =
				let
				    Source = DatabricksMultiCloud.Catalogs("dbc-a93985cd-4b0e.cloud.databricks.com", "/sql/1.0/warehouses/1f175bd517ba66d1", [Catalog = "", Database = ""]),
				    strava_catalog_Database = Source{[Name="strava_catalog",Kind="Database"]}[Data],
				    gold_Schema = strava_catalog_Database{[Name="gold",Kind="Schema"]}[Data],
				    gold_gear_usage_Table = gold_Schema{[Name="gold_gear_usage",Kind="Table"]}[Data]
				in
				    gold_gear_usage_Table

	annotation PBI_ResultType = Table

