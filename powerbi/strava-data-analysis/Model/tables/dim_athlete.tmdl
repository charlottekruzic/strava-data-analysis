table dim_athlete

	measure 'Athlete Name' = MAX(dim_athlete[firstname]) & " " & MAX(dim_athlete[lastname])

	column athlete_id
		dataType: int64
		formatString: 0
		sourceProviderType: bigint
		summarizeBy: none
		sourceColumn: athlete_id

		annotation SummarizationSetBy = Automatic

	column firstname
		dataType: string
		sourceProviderType: nvarchar(100)
		summarizeBy: none
		sourceColumn: firstname

		annotation SummarizationSetBy = Automatic

	column lastname
		dataType: string
		sourceProviderType: nvarchar(100)
		summarizeBy: none
		sourceColumn: lastname

		annotation SummarizationSetBy = Automatic

	column profile_url
		dataType: string
		sourceProviderType: nvarchar(500)
		dataCategory: ImageUrl
		summarizeBy: none
		sourceColumn: profile_url

		annotation SummarizationSetBy = Automatic

	partition dim_athlete = m
		mode: directQuery
		source =
				let
				    Source = DatabricksMultiCloud.Catalogs("dbc-a93985cd-4b0e.cloud.databricks.com", "/sql/1.0/warehouses/1f175bd517ba66d1", [Catalog = "", Database = ""]),
				    strava_catalog_Database = Source{[Name="strava_catalog",Kind="Database"]}[Data],
				    gold_Schema = strava_catalog_Database{[Name="gold",Kind="Schema"]}[Data],
				    dim_athlete_Table = gold_Schema{[Name="dim_athlete",Kind="Table"]}[Data]
				in
				    dim_athlete_Table

	annotation PBI_ResultType = Table

